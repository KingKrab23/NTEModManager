{
  "name": "nte-mod-manager",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop mod manager bootstrap for NTE.",
  "main": "dist/main/index.js",
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "extract-zip": "^2.0.1",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.cjs",
    "clean": "rimraf dist coverage",
    "dev": "run-p dev:renderer dev:main dev:electron",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 file:dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 nodemon --watch dist/main --watch dist/preload --ext js --exec electron .",
    "start": "npm run build && electron .",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged --allow-empty",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "release:win": "npm run build && electron-builder --win nsis zip --publish never",
    "harness:validate": "node scripts/validate-harness.mjs",
    "prepare": "husky",
    "preinstall": "npm run check:runtime"
  },
  "build": {
    "appId": "com.kingkrab23.ntemodmanager",
    "productName": "NTE Mod Manager",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,css,html}": [
      "prettier --check"
    ],
    "*.ts": [
      "eslint --max-warnings=0"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "@types/node-7z": "^2.1.11",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.6",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10"
  }
}
